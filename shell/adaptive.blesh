#!/usr/bin/env bash
# Adaptive frontend for ble.sh (Bash Line Editor).
#
# Generated by `adaptive init blesh`; do not edit -- regenerate instead.
#
# ---------------------------------------------------------------------------
# WHAT THIS ADAPTER DOES
# ---------------------------------------------------------------------------
# ble.sh replaces Readline with a line editor written in pure Bash that renders
# styled regions, so the inline suggestion can be *dimmed* -- the thing
# Readline cannot do, because it renders ANSI escapes literally and repaints
# with erase-to-EOL.
#
# Adaptive plugs in at ble.sh's documented extension point:
#
#   * `ble/complete/auto-complete/source:<name>` -- ble.sh asks each registered
#     source for an inline suggestion once the user pauses. Adaptive answers
#     here, so suggestions come from the learned engine rather than raw history
#     matching, and ble.sh paints the answer in a dim face.
#
# The ordinary `complete -D` completion is registered too, so the engine also
# answers Tab in the (rare) case where the shell falls back to Readline.
#
# ---------------------------------------------------------------------------
# KEY MAP -- deliberately the same as the Zsh frontend
# ---------------------------------------------------------------------------
#   Right / Ctrl-F    cycle to the next candidate, wrapping
#   Left  / Ctrl-B    cycle to the previous candidate, wrapping
#   Tab               accept the suggestion
#   Enter             run the line
#   Shift-Tab         list candidates backwards
#
# ble.sh ships Right bound to "accept the suggestion". That is a reasonable
# default, but it is not what a user coming from the Zsh frontend expects --
# there, Tab accepts and the arrows browse alternatives. Since the suggestion
# is only useful if you can choose between candidates, the arrows are rebound
# inside ble.sh's auto-complete keymap and fall through to ordinary cursor
# movement whenever no suggestion is showing, so they are never dead keys.

[[ $- == *i* ]] || return 0
[[ -n ${BASH_VERSION:-} ]] || return 0

# Detect that ble.sh is actually present, so sourcing this file by accident is
# harmless.
if ! [[ -n ${_ble_version:-} ]] \
   && ! declare -F ble/util/idle.push >/dev/null 2>&1 \
   && ! declare -F blehook >/dev/null 2>&1; then
  return 0
fi

: "${ADAPTIVE_BROWSE_KEY:=\e[Z}"
# Plain grey, matching the Zsh frontend's `fg=245`. Deliberately no background
# colour: the suggestion should read as dimmed text on the terminal's own
# background, not as a highlighted block.
: "${ADAPTIVE_BLE_FACE:=auto_complete}"
: "${ADAPTIVE_BLE_FACE_STYLE:=fg=245}"

_adaptive_init_paths
(( BASH_VERSINFO[0] >= 4 )) || return 0

# ---------------------------------------------------------------------------
# ble.sh style
# ---------------------------------------------------------------------------
# The style can be applied right away: ble.sh reads the face and the bleopt
# settings when it renders, and the values survive its own start-up.
_adaptive_blesh_style() {
  # Plain grey on the terminal's own background, matching the Zsh frontend's
  # `fg=245`. No background colour: the suggestion should read as dimmed text,
  # not as a highlighted block.
  # setface, not defface: `defface` records a default that ble.sh's own
  # `auto_complete` definition already set (bg=254,fg=238), so it has no
  # effect. `setface` overrides the face outright.
  ble/color/setface "$ADAPTIVE_BLE_FACE" "$ADAPTIVE_BLE_FACE_STYLE" 2>/dev/null || true

  # Everything else ble.sh decorates, turned off.
  #
  # The Zsh frontend shows one colour: a dim grey suggestion. A stock shell
  # shows none. ble.sh by default shows several -- syntax colours, a red
  # "[ble: exit 1]" after a failing command, a blue elapsed-time marker, and
  # two-tone completion menus -- so each of those is switched off here rather
  # than left for the user to notice and go hunting for.
  bleopt highlight_syntax=''

  # These two also make ble.sh stop and wait for RET after a command that
  # produced output, which reads as a freeze.
  bleopt exec_errexit_mark=''
  bleopt exec_elapsed_mark=''

  # Completion menus are coloured to match/prefix-highlight by default.
  bleopt complete_menu_color=''
  bleopt complete_menu_color_match=''
}
_adaptive_blesh_style

# ---------------------------------------------------------------------------
# inline suggestion
# ---------------------------------------------------------------------------
# Session state for cycling. These are initialised rather than unset so the
# file is safe to source inside a `set -u` shell.
: "${_ADAPTIVE_BLE_INDEX:=1}"
: "${_ADAPTIVE_BLE_TYPED:=}"
: "${_ADAPTIVE_BLE_SHOWN:=}"
_ADAPTIVE_BLE_CANDIDATES=()

# Ask the engine what belongs at the end of `$1` and leave the ranked
# candidates in _ADAPTIVE_BLE_CANDIDATES. Only values that are a strict
# extension of the partial word are kept -- anything else would be a guess the
# user did not ask for.
#
# This runs on ble.sh's idle pass, so it forks one `adaptive query` per pause.
# The engine answers in about 2ms and caches per word in the core runtime.
_adaptive_blesh_candidates() {
  local text=$1 value typed out
  _ADAPTIVE_BLE_CANDIDATES=()
  [[ -n $text ]] || return 1
  _adaptive_find_bin || return 1

  out=$("${ADAPTIVE_BIN_PATH}" query --format zsh \
        --buffer "$text" --cursor "${#text}" --cwd "$PWD" \
        --prev "${_ADAPTIVE_PREV_CMD:-}" 2>/dev/null) || return 1
  [[ -n $out ]] || return 1

  # Row 1 is the header; the rows after it start with `value<TAB>display<...>`.
  value=${out#*$'\n'}
  [[ $value == "$out" ]] && return 1

  typed=${text##*[[:space:]]}
  while IFS= read -r value; do
    [[ -n $value ]] || continue
    IFS=$'\t' read -r value _ <<<"$value"
    [[ -n $value && $value == "$typed"* ]] || continue
    (( ${#value} > ${#typed} )) || continue
    _ADAPTIVE_BLE_CANDIDATES+=("$value")
  done <<<"${out#*$'\n'}"

  (( ${#_ADAPTIVE_BLE_CANDIDATES[@]} )) || return 1
  return 0
}

# Paint the candidate at the current index as the inline suggestion.
#
# Re-painting replaces whatever was painted before: ble.sh's
# `auto-complete/enter` appends at the cursor, so the old suggestion has to be
# deleted first or the two would concatenate.
_adaptive_ble_render() {
  local cand=${_ADAPTIVE_BLE_CANDIDATES[_ADAPTIVE_BLE_INDEX]:-}
  [[ -n $cand ]] || return 1
  local word=${_ADAPTIVE_BLE_TYPED##*[[:space:]]}
  local suggest=${cand:${#word}}
  [[ -n $suggest ]] || return 1

  if [[ ${_ble_edit_mark_active:-} == auto_complete ]] \
     && (( ${_ble_edit_mark:-0} > _ble_edit_ind )); then
    ble-edit/content/replace "$_ble_edit_ind" "$_ble_edit_mark" ''
  fi
  _ADAPTIVE_BLE_SHOWN=$suggest
  # `h` marks it as a history-derived whole-line completion, which is how ble.sh
  # treats something the user has run before rather than a menu entry.
  ble/complete/auto-complete/enter h 0 "$suggest" "$cand" '' "$cand"
}

# Is there a suggestion on screen that the arrows may cycle through?
#
# The line is checked as well as the state: if the user has moved the cursor or
# typed since the suggestion was drawn, the candidates belong to a position that
# no longer exists, and cycling would rewrite text that is no longer there.
_adaptive_ble_cycling() {
  [[ ${_ble_edit_mark_active:-} == auto_complete ]] || return 1
  [[ -n ${_ADAPTIVE_BLE_SHOWN:-} ]] || return 1
  (( ${#_ADAPTIVE_BLE_CANDIDATES[@]} > 1 )) || return 1
  [[ -n ${_ADAPTIVE_BLE_TYPED:-} ]] || return 1
  [[ $_ble_edit_str == "$_ADAPTIVE_BLE_TYPED"* ]] || return 1
  (( _ble_edit_ind == ${#_ADAPTIVE_BLE_TYPED} )) || return 1
  return 0
}

function ble/complete/auto-complete/source:adaptive {
  # Only useful at the end of the line: mid-line there is nowhere to show it,
  # which is the same rule the Zsh frontend applies.
  (( _ble_edit_ind == ${#_ble_edit_str} )) || return 1
  local text=$_ble_edit_str
  [[ -n $text ]] || return 1

  _adaptive_blesh_candidates "$text" || return 1
  _ADAPTIVE_BLE_TYPED=$text
  _ADAPTIVE_BLE_INDEX=1
  _ADAPTIVE_BLE_SHOWN=
  _adaptive_ble_render
}

# ---------------------------------------------------------------------------
# arrow-key cycling
# ---------------------------------------------------------------------------

function ble/widget/adaptive-cycle-next {
  if _adaptive_ble_cycling; then
    (( _ADAPTIVE_BLE_INDEX++ ))
    (( _ADAPTIVE_BLE_INDEX > ${#_ADAPTIVE_BLE_CANDIDATES[@]} )) && _ADAPTIVE_BLE_INDEX=1
    _adaptive_ble_render
  else
    ble/widget/forward-char
  fi
}

function ble/widget/adaptive-cycle-prev {
  if _adaptive_ble_cycling; then
    (( _ADAPTIVE_BLE_INDEX-- ))
    (( _ADAPTIVE_BLE_INDEX < 1 )) && _ADAPTIVE_BLE_INDEX=${#_ADAPTIVE_BLE_CANDIDATES[@]}
    _adaptive_ble_render
  else
    ble/widget/backward-char
  fi
}

# Shift-Tab, as a named widget.
#
# ble.sh's own Shift-Tab is `menu-complete backward`: the direction is an
# argument, and a key binding can only name a function. Binding the Readline
# compatibility name `menu-complete-backward` instead fails at bind time with
# "Unknown widget", because it is a table entry, not a function.
function ble/widget/adaptive-menu-complete-backward {
  ble/widget/menu-complete backward
}

# ---------------------------------------------------------------------------
# key bindings
# ---------------------------------------------------------------------------
# The bindings go through `ble-bind`, ble.sh's user-facing binding command: it
# turns a key *name* into the key *code* the decoder matches on.
#
# The low-level `ble-decode-key/bind` must not be used for this. It expects
# key codes, not key names, and it builds the keymap array subscript with
# `builtin eval`, so a name such as "right" or "\e[Z" ends up being evaluated
# as an arithmetic expression. When that expression is not a number, bash
# raises a syntax error inside the eval -- and in an interactive shell a
# syntax error aborts the whole enclosing command. The enclosing command here
# is ble.sh's own prompt-rendering chain, so the prompt is never restored,
# PS1 keeps ble.sh's internal placeholder, and every new terminal greets the
# user with "[ble: press RET to continue]".
#
# The bindings are made from ble.sh's idle queue, because the keymap they
# belong to (`auto_complete`, the one in force while a suggestion is on
# screen) is defined in ble.sh's completion core, which ble.sh imports only
# when it is first needed. Until that import has happened ble.sh does not
# know the keymap at all.

# The browse key, as a ble.sh key specification.
#
# ble.sh's own keymaps call Shift-Tab "S-TAB", and that is what the emacs
# keymap already binds to `menu-complete backward`, so the default raw key
# (ESC [ Z) is expressed with that name. Any other key is passed on as the
# exact character sequence the terminal sends.
: "${ADAPTIVE_BLE_BROWSE_KEY:=}"
_adaptive_blesh_keyspec() {
  if [[ -n $ADAPTIVE_BLE_BROWSE_KEY ]]; then
    printf '%s' "$ADAPTIVE_BLE_BROWSE_KEY"
    return 0
  fi
  local raw=${ADAPTIVE_BROWSE_KEY:-}
  if [[ $raw == $'\e[Z' || $raw == '\e[Z' ]]; then
    printf 'S-TAB'
    return 0
  fi
  # Anything else: the Readline-style text form of the raw bytes, which
  # ble.sh's `keyseq:` specification understands.
  local out= i c code
  for ((i=0; i<${#raw}; i++)); do
    c=${raw:i:1}
    case $c in
      ($'\e') out+='\e' ;;
      ($'\t') out+='\t' ;;
      ($'\n') out+='\n' ;;
      ($'\r') out+='\r' ;;
      (*)
        printf -v code '%d' "'$c"
        if ((code < 32 || code == 127)); then
          out+=$(printf '\\x%02x' "$code")
        else
          out+=$c
        fi
        ;;
    esac
  done
  printf 'keyseq:%s' "$out"
}

# Register Adaptive ahead of ble.sh's own history matcher: the engine knows
# about command structure and learned habits, and the raw-history fallback is
# still there as a second opinion.
#
# `_ble_complete_auto_source` is a plain *indexed* array in ble.sh -- that is
# how ble.sh's own completion core declares it, and how the helpers that
# insert into it expect it. Turning it into an associative array makes ble.sh
# iterate the sources in hash order and breaks those helpers, so the type is
# checked here and repaired if an older version of this adapter left it
# converted.
_adaptive_blesh_register_source() {
  local decl
  decl=$(declare -p _ble_complete_auto_source 2>/dev/null) || return 0
  [[ $decl == 'declare -A '* ]] && unset -v _ble_complete_auto_source
  _ble_complete_auto_source=(adaptive history syntax)
}

_adaptive_blesh_bind() {
  # The auto-complete keymap lives in ble.sh's completion core. Importing it
  # here is a no-op when ble.sh has already imported it (which it has, by the
  # time the idle queue runs) and makes the keymap known in the rare case
  # where it has not.
  ble-import lib/core-complete >/dev/null 2>&1 || true

  # The arrows are rebound inside the auto-complete keymap -- the keymap in
  # force exactly while a suggestion is on screen -- so with no suggestion
  # showing, Right and Left keep their normal meaning of cursor movement.
  local browse
  browse=$(_adaptive_blesh_keyspec)
  # `-f` names a ble.sh widget: ble-bind prefixes `ble/widget/` itself, so
  # the widget is given by its bare name. (Without a command-type flag
  # ble-bind rejects the arguments outright, and says so.)
  ble-bind -m auto_complete -f 'right' 'adaptive-cycle-next' || true
  ble-bind -m auto_complete -f 'C-f'   'adaptive-cycle-next' || true
  ble-bind -m auto_complete -f 'left'  'adaptive-cycle-prev'  || true
  ble-bind -m auto_complete -f 'C-b'   'adaptive-cycle-prev'  || true
  # Shift-Tab walks the candidate list backwards.
  ble-bind -m auto_complete -f "$browse" 'adaptive-menu-complete-backward' || true
  ble-bind -m emacs -f "$browse" 'adaptive-menu-complete-backward' || true

  _adaptive_blesh_register_source
}

if ble/is-function ble/util/idle.push >/dev/null 2>&1; then
  ble/util/idle.push _adaptive_blesh_bind
else
  # No idle queue (very old ble.sh): apply directly and hope for the best.
  _adaptive_blesh_bind
fi

# ---------------------------------------------------------------------------
# Tab and Shift-Tab
# ---------------------------------------------------------------------------

_adaptive_complete_buffer() {
  printf '%s' "${COMP_LINE:-${READLINE_LINE:-}}"
}

_adaptive_complete() {
  local cur=${COMP_WORDS[${COMP_CWORD:-0}]:-}
  local out
  COMPREPLY=()
  out=$(_adaptive_query "$(_adaptive_complete_buffer)" "${COMP_POINT:-${#COMP_LINE}}" 1) || return 124
  [[ -n $out ]] || return 124
  _adaptive_parse <<<"$out"
  local v
  for v in ${ADAPTIVE_Q_VALUES[@]+"${ADAPTIVE_Q_VALUES[@]}"}; do
    [[ -n $v ]] || continue
    [[ -n $cur && $v != "$cur"* ]] && continue
    COMPREPLY+=("$v")
  done
  (( ${#COMPREPLY[@]} )) || return 124
  return 0
}

builtin complete -D -F _adaptive_complete -o filenames 2>/dev/null || true
builtin complete -E -F _adaptive_complete -o filenames 2>/dev/null || true

# ---------------------------------------------------------------------------
# history
# ---------------------------------------------------------------------------
# Bash has no preexec hook, so the accepted line is recovered from Bash's own
# history when the next prompt is drawn.
_adaptive_blesh_history_record() {
  local line
  line=$(HISTTIMEFORMAT= builtin history 1 2>/dev/null) || return 0
  line=${line#*  }
  [[ -n $line ]] || return 0
  [[ $line == "${_ADAPTIVE_SEEN_HISTORY:-}" ]] && return 0
  _ADAPTIVE_SEEN_HISTORY=$line
  _adaptive_history_record "$line"
  return 0
}

if [[ ${PROMPT_COMMAND:-} != *_adaptive_blesh_history_record* ]]; then
  if [[ -z ${PROMPT_COMMAND:-} ]]; then
    PROMPT_COMMAND='_adaptive_blesh_history_record'
  else
    PROMPT_COMMAND="${PROMPT_COMMAND%;};_adaptive_blesh_history_record"
  fi
fi

# Fold existing history into the usage profile once.
_ADAPTIVE_SEEN_HISTORY=$(HISTTIMEFORMAT= builtin history 1 2>/dev/null)
_ADAPTIVE_SEEN_HISTORY=${_ADAPTIVE_SEEN_HISTORY#*  }
_adaptive_history_import
