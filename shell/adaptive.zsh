# Adaptive Zsh frontend. Generated by `adaptive init zsh`.
# Pure inline suggestion UI: one ghost-text candidate at a time, no menus.
#
# Interaction states:
#   IDLE            no suggestion, no selector
#   GHOST           one predicted continuation of a user-typed prefix, shown dim
#   OPTION_SELECTOR explicit candidate browser opened by TAB with no ghost active
#   (JUST_ACCEPTED is simply IDLE again: acceptance never carries forward
#    permission to keep auto-suggesting without new user intent)
[[ -o interactive ]] || return 0

: ${ADAPTIVE_GHOST_TEXT:=1}
: ${ADAPTIVE_GHOST_STYLE:=fg=245}
: ${ADAPTIVE_SELECTOR_STYLE:=fg=245}
: ${ADAPTIVE_SELECTOR_SELECTED_STYLE:=standout}
: ${ADAPTIVE_ACCEPT_KEY:=^I}
: ${ADAPTIVE_CYCLE_NEXT_KEY:=^[[C}
: ${ADAPTIVE_CYCLE_PREV_KEY:=^[[D}
: ${ADAPTIVE_DISMISS_KEY:=^[}

typeset -g ADAPTIVE_QUERY_FD="" ADAPTIVE_QUERY_BUFFER="" ADAPTIVE_QUERY_CURSOR=0 ADAPTIVE_QUERY_KIND="ghost"
typeset -g ADAPTIVE_PREFIX_LEN=0 ADAPTIVE_INDEX=1 ADAPTIVE_SELECTOR_ACTIVE=0 ADAPTIVE_LIST_INDEX=1
typeset -ga ADAPTIVE_VALUES ADAPTIVE_DISPLAYS ADAPTIVE_DESCRIPTIONS ADAPTIVE_SOURCES
typeset -ga ADAPTIVE_LIST_VALUES ADAPTIVE_LIST_DISPLAYS ADAPTIVE_LIST_DESCRIPTIONS ADAPTIVE_LIST_SOURCES
typeset -ga ADAPTIVE_OWN_HIGHLIGHTS region_highlight

# Opt-in diagnostics: export ADAPTIVE_DEBUG_LOG=/tmp/adaptive-debug.log before
# `exec zsh` to get a trace of state transitions for bug reports. No-op when
# unset.
[[ -n "$ADAPTIVE_DEBUG_LOG" ]] && zmodload zsh/datetime 2>/dev/null
_adaptive_log() {
  [[ -n "$ADAPTIVE_DEBUG_LOG" ]] || return 0
  print -r -- "$EPOCHREALTIME $*" >>"$ADAPTIVE_DEBUG_LOG"
}

# ---- shared display rendering (POSTDISPLAY is used by ghost XOR selector) ---

_adaptive_clear_ghost() {
  POSTDISPLAY=""
  if (( ${#ADAPTIVE_OWN_HIGHLIGHTS} )); then
    local -a kept
    local h o hit
    for h in "${region_highlight[@]}"; do
      hit=0
      for o in "${ADAPTIVE_OWN_HIGHLIGHTS[@]}"; do
        [[ "$h" == "$o" ]] && { hit=1; break }
      done
      (( hit )) || kept+=("$h")
    done
    region_highlight=("${kept[@]}")
    ADAPTIVE_OWN_HIGHLIGHTS=()
  fi
}

_adaptive_set_ghost() {
  _adaptive_clear_ghost
  POSTDISPLAY="$1"
  if [[ -n "$POSTDISPLAY" ]]; then
    local entry="$#BUFFER $(( $#BUFFER + $#POSTDISPLAY )) $ADAPTIVE_GHOST_STYLE"
    ADAPTIVE_OWN_HIGHLIGHTS+=("$entry")
    region_highlight+=("$entry")
  fi
}

# Renders ADAPTIVE_VALUES[ADAPTIVE_INDEX] as ghost text. With an empty
# current token this only auto-suggests when there is exactly one candidate
# (an unambiguous, high-confidence continuation like "git clone " ->
# https://github.com/); with two or more it stays silent and waits for
# either a typed prefix or an explicit TAB into the option selector. This is
# what stops acceptance from handing the engine permission to keep
# manufacturing further tokens on its own.
_adaptive_render_current() {
  _adaptive_clear_ghost
  (( ${#ADAPTIVE_VALUES} )) || { _adaptive_log "render_current gate=fail reason=no_values"; return 1 }
  (( CURSOR == $#BUFFER )) || { _adaptive_log "render_current gate=fail reason=cursor_not_at_end"; return 1 }
  (( ADAPTIVE_PREFIX_LEN > 0 || ${#ADAPTIVE_VALUES} == 1 )) || { _adaptive_log "render_current gate=fail reason=needs_prefix prefix_len=$ADAPTIVE_PREFIX_LEN values=${#ADAPTIVE_VALUES}"; return 1 }
  [[ "$ADAPTIVE_GHOST_TEXT" == 1 ]] || { _adaptive_log "render_current gate=fail reason=ghost_text_disabled"; return 1 }
  local typed candidate="${ADAPTIVE_VALUES[ADAPTIVE_INDEX]}"
  # $LBUFFER[-0,-1] is NOT empty in zsh -- negative zero slices as the whole
  # string, not zero-width -- so the empty-prefix case must be special-cased.
  (( ADAPTIVE_PREFIX_LEN > 0 )) && typed="${LBUFFER[-$ADAPTIVE_PREFIX_LEN,-1]}" || typed=""
  [[ "$candidate" == "$typed"* && "$candidate" != "$typed" ]] || { _adaptive_log "render_current gate=fail reason=candidate_mismatch typed=[$typed] candidate=[$candidate]"; return 1 }
  _adaptive_set_ghost "${candidate#$typed}"
  _adaptive_log "render_current gate=pass typed=[$typed] postdisplay=[$POSTDISPLAY]"
  return 0
}

_adaptive_active() {
  [[ -n "$POSTDISPLAY" ]] && (( CURSOR == $#BUFFER )) && (( ! ADAPTIVE_SELECTOR_ACTIVE ))
}

# ---- explicit option selector (opened by TAB when no ghost is active) ------

_adaptive_close_selector() {
  (( ADAPTIVE_SELECTOR_ACTIVE )) || return 0
  _adaptive_clear_ghost
  ADAPTIVE_SELECTOR_ACTIVE=0
  ADAPTIVE_LIST_INDEX=1
  ADAPTIVE_LIST_VALUES=(); ADAPTIVE_LIST_DISPLAYS=(); ADAPTIVE_LIST_DESCRIPTIONS=(); ADAPTIVE_LIST_SOURCES=()
}

# Draws the candidate row on the line below the cursor, via POSTDISPLAY, with
# the selected candidate highlighted -- never a printed zle -M menu.
_adaptive_render_selector() {
  _adaptive_clear_ghost
  (( ${#ADAPTIVE_LIST_VALUES} )) || return 1
  local i display sep="  " text=$'\n' start end entry
  local offset=$(( $#BUFFER + 1 ))
  local limit=$(( ${#ADAPTIVE_LIST_VALUES} < 12 ? ${#ADAPTIVE_LIST_VALUES} : 12 ))
  for (( i = 1; i <= limit; i++ )); do
    display="${ADAPTIVE_LIST_DISPLAYS[i]:-${ADAPTIVE_LIST_VALUES[i]}}"
    start=$offset
    end=$(( offset + $#display ))
    if (( i == ADAPTIVE_LIST_INDEX )); then
      entry="$start $end $ADAPTIVE_SELECTOR_SELECTED_STYLE"
    else
      entry="$start $end $ADAPTIVE_SELECTOR_STYLE"
    fi
    ADAPTIVE_OWN_HIGHLIGHTS+=("$entry")
    region_highlight+=("$entry")
    text+="$display"
    offset=$end
    if (( i < limit )); then
      text+="$sep"
      offset=$(( offset + $#sep ))
    fi
  done
  POSTDISPLAY="$text"
  return 0
}

# ---- state lifecycle -------------------------------------------------------

_adaptive_cancel_query() {
  if [[ -n "$ADAPTIVE_QUERY_FD" ]]; then
    zle -F "$ADAPTIVE_QUERY_FD" 2>/dev/null
    exec {ADAPTIVE_QUERY_FD}<&- 2>/dev/null
    ADAPTIVE_QUERY_FD=""
  fi
}

_adaptive_reset() {
  _adaptive_close_selector
  _adaptive_clear_ghost
  _adaptive_cancel_query
  ADAPTIVE_QUERY_BUFFER=""
  ADAPTIVE_QUERY_CURSOR=0
  ADAPTIVE_INDEX=1
  ADAPTIVE_VALUES=(); ADAPTIVE_DISPLAYS=(); ADAPTIVE_DESCRIPTIONS=(); ADAPTIVE_SOURCES=()
}

_adaptive_load_results() {
  local fd=$1 value display description source count request
  local -a values displays descriptions sources
  if IFS=$'\t' read -r request ADAPTIVE_PREFIX_LEN count <&$fd; then
    while IFS=$'\t' read -r value display description source <&$fd; do
      values+=("$value"); displays+=("$display")
      descriptions+=("$description"); sources+=("$source")
    done
  else
    ADAPTIVE_PREFIX_LEN=0
  fi
  if [[ "$ADAPTIVE_QUERY_KIND" == "selector" ]]; then
    ADAPTIVE_LIST_VALUES=("${values[@]}"); ADAPTIVE_LIST_DISPLAYS=("${displays[@]}")
    ADAPTIVE_LIST_DESCRIPTIONS=("${descriptions[@]}"); ADAPTIVE_LIST_SOURCES=("${sources[@]}")
    ADAPTIVE_LIST_INDEX=1
  else
    ADAPTIVE_VALUES=("${values[@]}"); ADAPTIVE_DISPLAYS=("${displays[@]}")
    ADAPTIVE_DESCRIPTIONS=("${descriptions[@]}"); ADAPTIVE_SOURCES=("${sources[@]}")
    ADAPTIVE_INDEX=1
  fi
  zle -F "$fd" 2>/dev/null
  exec {fd}<&-
  [[ "$ADAPTIVE_QUERY_FD" == "$fd" ]] && ADAPTIVE_QUERY_FD=""
}

# Async result handler: only apply results if the buffer is still exactly
# what it was when the query was issued (a cheap generation check), so a
# slow/late response can never clobber what the user is looking at now.
_adaptive_ready() {
  local fd=$1
  if [[ "$BUFFER" != "$ADAPTIVE_QUERY_BUFFER" ]] || (( CURSOR != ADAPTIVE_QUERY_CURSOR )); then
    zle -F "$fd" 2>/dev/null
    exec {fd}<&- 2>/dev/null
    [[ "$ADAPTIVE_QUERY_FD" == "$fd" ]] && ADAPTIVE_QUERY_FD=""
    return
  fi
  local kind="$ADAPTIVE_QUERY_KIND"
  _adaptive_load_results "$fd"
  if [[ "$kind" == "selector" ]]; then
    if (( ${#ADAPTIVE_LIST_VALUES} )); then
      ADAPTIVE_SELECTOR_ACTIVE=1
      _adaptive_render_selector
      _adaptive_log "ready kind=selector list_values=${#ADAPTIVE_LIST_VALUES} postdisplay=[$POSTDISPLAY]"
    else
      ADAPTIVE_SELECTOR_ACTIVE=0
      _adaptive_log "ready kind=selector list_values=0 fallback=native_completion"
      zle .expand-or-complete
    fi
  else
    _adaptive_log "ready kind=ghost values=${#ADAPTIVE_VALUES} prefix_len=$ADAPTIVE_PREFIX_LEN buffer=[$BUFFER]"
    _adaptive_auto_selector_after_slash || _adaptive_render_current
  fi
  zle -R
}

# A trailing "/" is a structural boundary (finished typing an owner, a
# directory, a path segment) exactly like the cd<TAB> directory browser --
# when it leaves several equally-plausible candidates, show them as a
# browsable list instead of silently picking one and hiding the rest behind
# an undiscoverable TAB press. Returns 0 (and opens the selector) only when
# that boundary condition is met; the caller falls back to normal ghost
# rendering otherwise.
_adaptive_auto_selector_after_slash() {
  (( ${#ADAPTIVE_VALUES} > 1 )) || return 1
  [[ "$BUFFER" == */ ]] && (( CURSOR == $#BUFFER )) || return 1
  ADAPTIVE_LIST_VALUES=("${ADAPTIVE_VALUES[@]}")
  ADAPTIVE_LIST_DISPLAYS=("${ADAPTIVE_DISPLAYS[@]}")
  ADAPTIVE_LIST_DESCRIPTIONS=("${ADAPTIVE_DESCRIPTIONS[@]}")
  ADAPTIVE_LIST_SOURCES=("${ADAPTIVE_SOURCES[@]}")
  ADAPTIVE_LIST_INDEX=1
  ADAPTIVE_SELECTOR_ACTIVE=1
  _adaptive_render_selector
  _adaptive_log "auto_selector_after_slash values=${#ADAPTIVE_VALUES}"
  return 0
}

_adaptive_schedule() {
  _adaptive_cancel_query
  ADAPTIVE_QUERY_KIND="ghost"
  ADAPTIVE_QUERY_BUFFER="$BUFFER"
  ADAPTIVE_QUERY_CURSOR=$CURSOR
  exec {ADAPTIVE_QUERY_FD}< <(adaptive query --format zsh --buffer "$BUFFER" --cursor "$CURSOR" --cwd "$PWD" 2>/dev/null)
  zle -F -w "$ADAPTIVE_QUERY_FD" adaptive-ready
}

# Explicit "what can go here?" request: only issued when TAB is pressed with
# no ghost suggestion visible to accept.
_adaptive_schedule_selector() {
  _adaptive_cancel_query
  ADAPTIVE_QUERY_KIND="selector"
  ADAPTIVE_QUERY_BUFFER="$BUFFER"
  ADAPTIVE_QUERY_CURSOR=$CURSOR
  exec {ADAPTIVE_QUERY_FD}< <(adaptive query --format zsh --list --buffer "$BUFFER" --cursor "$CURSOR" --cwd "$PWD" 2>/dev/null)
  zle -F -w "$ADAPTIVE_QUERY_FD" adaptive-ready
}

# ---- typing -----------------------------------------------------------------

adaptive-self-insert() {
  _adaptive_close_selector
  _adaptive_clear_ghost
  zle .self-insert
  _adaptive_schedule
}
adaptive-backward-delete-char() {
  _adaptive_close_selector
  _adaptive_clear_ghost
  zle .backward-delete-char
  _adaptive_schedule
}

# ---- accept / cycle / dismiss -----------------------------------------------

adaptive-accept() {
  _adaptive_log "accept active=$(_adaptive_active && echo 1 || echo 0) selector=$ADAPTIVE_SELECTOR_ACTIVE postdisplay=[$POSTDISPLAY]"
  if _adaptive_active; then
    local value="${ADAPTIVE_VALUES[ADAPTIVE_INDEX]}"
    local keep=$(( ${#LBUFFER} - ADAPTIVE_PREFIX_LEN )) completed
    (( keep > 0 )) && completed="${LBUFFER[1,$keep]}" || completed=""
    completed+="$value"
    if [[ -z "$RBUFFER" && "$value" != */ && "$value" != *= && "$value" != *: ]]; then
      completed+=' '
    fi
    _adaptive_reset
    LBUFFER="$completed"
    _adaptive_schedule
    return
  fi
  if (( ADAPTIVE_SELECTOR_ACTIVE )); then
    (( ${#ADAPTIVE_LIST_VALUES} )) || { _adaptive_reset; zle .expand-or-complete; return }
    local value="${ADAPTIVE_LIST_VALUES[ADAPTIVE_LIST_INDEX]}"
    local keep=$(( ${#LBUFFER} - ADAPTIVE_PREFIX_LEN )) completed
    (( keep > 0 )) && completed="${LBUFFER[1,$keep]}" || completed=""
    completed+="$value"
    if [[ -z "$RBUFFER" && "$value" != */ && "$value" != *= && "$value" != *: ]]; then
      completed+=' '
    fi
    _adaptive_reset
    LBUFFER="$completed"
    _adaptive_schedule
    return
  fi
  # No ghost, no selector: TAB explicitly asks "what can go here?" -- browse,
  # never blindly insert the top-ranked candidate.
  _adaptive_schedule_selector
}

adaptive-cycle-next() {
  if (( ADAPTIVE_SELECTOR_ACTIVE )); then
    (( ${#ADAPTIVE_LIST_VALUES} > 1 )) || return 0
    (( ADAPTIVE_LIST_INDEX++ ))
    (( ADAPTIVE_LIST_INDEX > ${#ADAPTIVE_LIST_VALUES} )) && ADAPTIVE_LIST_INDEX=1
    _adaptive_render_selector
    zle -R
  elif _adaptive_active; then
    (( ${#ADAPTIVE_VALUES} > 1 )) || return 0
    (( ADAPTIVE_INDEX++ ))
    (( ADAPTIVE_INDEX > ${#ADAPTIVE_VALUES} )) && ADAPTIVE_INDEX=1
    _adaptive_render_current
    zle -R
  else
    zle .forward-char
  fi
}

adaptive-cycle-prev() {
  if (( ADAPTIVE_SELECTOR_ACTIVE )); then
    (( ${#ADAPTIVE_LIST_VALUES} > 1 )) || return 0
    (( ADAPTIVE_LIST_INDEX-- ))
    (( ADAPTIVE_LIST_INDEX < 1 )) && ADAPTIVE_LIST_INDEX=${#ADAPTIVE_LIST_VALUES}
    _adaptive_render_selector
    zle -R
  elif _adaptive_active; then
    (( ${#ADAPTIVE_VALUES} > 1 )) || return 0
    (( ADAPTIVE_INDEX-- ))
    (( ADAPTIVE_INDEX < 1 )) && ADAPTIVE_INDEX=${#ADAPTIVE_VALUES}
    _adaptive_render_current
    zle -R
  else
    zle .backward-char
  fi
}

adaptive-dismiss() {
  if (( ADAPTIVE_SELECTOR_ACTIVE )); then
    _adaptive_close_selector
    zle -R
  elif _adaptive_active; then
    _adaptive_reset
    zle -R
  else
    zle .send-break
  fi
}

adaptive-up-line() { _adaptive_reset; zle .up-line-or-history }
adaptive-down-line() { _adaptive_reset; zle .down-line-or-history }

adaptive-line-init() { _adaptive_reset }
adaptive-line-finish() { _adaptive_reset }

_adaptive_history_hook() { adaptive history record -- "${1%$'\n'}" >/dev/null 2>&1 &!; return 0 }

# ---- widget registration -----------------------------------------------------

zle -N self-insert adaptive-self-insert
zle -N backward-delete-char adaptive-backward-delete-char
zle -N adaptive-accept
zle -N adaptive-cycle-next
zle -N adaptive-cycle-prev
zle -N adaptive-dismiss
zle -N adaptive-up-line
zle -N adaptive-down-line
zle -N zle-line-init adaptive-line-init
zle -N zle-line-finish adaptive-line-finish
zle -N adaptive-ready _adaptive_ready

bindkey "$ADAPTIVE_ACCEPT_KEY" adaptive-accept
bindkey "$ADAPTIVE_CYCLE_NEXT_KEY" adaptive-cycle-next
bindkey "$ADAPTIVE_CYCLE_PREV_KEY" adaptive-cycle-prev
bindkey "$ADAPTIVE_DISMISS_KEY" adaptive-dismiss
bindkey '^[[A' adaptive-up-line
bindkey '^[[B' adaptive-down-line

autoload -Uz add-zsh-hook
add-zsh-hook zshaddhistory _adaptive_history_hook
